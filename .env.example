# Docker host port mapped to the container's fixed port 8080.
NEXTDASH_HOST_PORT=8080

# Single administrator login name.
NEXTDASH_ADMIN_USERNAME=admin

# Required. Generate with: docker run --rm -it ghcr.io/jordibrouwer/nextdash:latest hash-password
# Keep the generated Argon2 PHC string in single quotes so Docker Compose does not expand its $ characters.
NEXTDASH_ADMIN_PASSWORD_HASH='replace-with-generated-argon2id-hash'

# Use 0 for local plain HTTP; use 1 when serving through HTTPS.
NEXTDASH_AUTH_COOKIE_SECURE=0

# Optional browser-extension credential. Leave empty when the extension is not used.
NEXTDASH_WRITE_TOKEN=
